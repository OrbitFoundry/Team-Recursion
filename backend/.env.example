# ============================================
# REQUIRED - Environment Configuration
# ============================================

# Database Connection (REQUIRED)
# In local development mode, fallback to in-memory MongoDB will be used if unreachable.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/auth-app

# JWT Secret (REQUIRED - Minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Session Secret (OPTIONAL - defaults to JWT_SECRET if not set)
SESSION_SECRET=your_super_secret_session_key_32_chars_long

# Frontend URL (REQUIRED - for CORS allowed origins)
FRONTEND_URL=http://localhost:3000

# ============================================
# OPTIONAL - Server Configuration
# ============================================

PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d

# ============================================
# OPTIONAL - Google OAuth Credentials
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ============================================
# OPTIONAL - SMTP Email Configuration
# ============================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@yourapp.com

# ============================================
# OPTIONAL - Render Keep-Alive / Always-On
# ============================================
# Automatically keeps Render free-tier instance active by self-pinging /health every 10 mins
KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=https://cooked-backend.onrender.com

